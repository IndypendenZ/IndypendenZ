# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง
# Claude API key ของคุณ (เอามาจาก https://console.anthropic.com/ -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# CoinGecko Demo API key (ฟรี) — แนะนำให้ใส่ จะได้ลิมิตสูงขึ้นมาก (30 ครั้ง/นาที)
# จำเป็นมากถ้าจะใช้หน้า RSI (ดึงข้อมูลหลายเหรียญรวด)
# ขอที่ https://www.coingecko.com/en/developers/dashboard -> Add New Key
COINGECKO_API_KEY=

# พอร์ตที่จะรัน (ไม่ใส่ก็ได้ ค่าเริ่มต้น 8080)
# PORT=8080
